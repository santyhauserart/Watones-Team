  m_EditorClassIdentifier: 
  dialogueMark: {fileID: 2004879756}
  dialoguePanel: {fileID: 311876344}
  dialogueText: {fileID: 158347050}
  dialogueLines:
  - '*El Mati: Hola, soy Matias.'
  - "*El Mati: Mi mejor amigo me dejo un regalo de cumplea\xF1os."
  - '*El Mati: Pense que lo habia olvidado, ya que fue hace como 3 meses.'
  - '*El Mati: El siempre es asi, sabes? Incluso olvido que no tengo brazos para
    abrirlo.'
  - '*El Mati: Estoy seguro que lo recordara en cualquier momento y volvera para
    abrirlo juntos.'
  - '*El Mati: Mientras tanto, esperare aqui :).'
